{
  "name": "betacode",
  "version": "0.1.0",
  "private": true,
  "description": "AI coding agent for your projects.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run && pnpm --filter @betacode/desktop test",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @betacode/desktop typecheck",
    "db:generate": "pnpm --filter @betacode/database generate",
    "server": "pnpm --filter @betacode/server start",
    "cli": "pnpm --filter @betacode/cli start",
    "desktop": "pnpm --filter @betacode/desktop dev",
    "dev": "pnpm --parallel --filter @betacode/server --filter @betacode/desktop dev",
    "db:sql": "node scripts/gen-db-sql.mjs",
    "package": "pnpm --filter @betacode/desktop tauri build"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
