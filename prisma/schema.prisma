// BetaCode local database (SQLite). Stored at ~/.betacode/betacode.db by default.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserPreference {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Project {
  id         String    @id @default(cuid())
  path       String    @unique
  name       String
  /// JSON: detected frameworks, package manager, commands.
  metadata   String?
  lastOpened DateTime  @default(now())
  createdAt  DateTime  @default(now())
  sessions   Session[]
}

model Session {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  mode        String       @default("code")
  provider    String
  model       String
  /// Compaction summary of earlier messages (null if never compacted).
  summary     String?
  /// Number of persisted messages already folded into `summary`.
  foldedCount Int          @default(0)
  /// JSON: current task plan.
  plan        String?
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    Message[]
  toolCalls   ToolCall[]
  fileChanges FileChange[]

  @@index([projectId, updatedAt])
}

model Message {
  id            String   @id @default(cuid())
  sessionId     String
  seq           Int
  role          String
  content       String
  /// JSON array of {id,name,arguments} for assistant messages.
  toolCallsJson String?
  toolCallId    String?
  name          String?
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
}

model ToolCall {
  id         String   @id @default(cuid())
  sessionId  String
  callId     String
  name       String
  args       String
  result     String?
  ok         Boolean?
  durationMs Int?
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model FileChange {
  id        String   @id
  sessionId String
  path      String
  /// Original content (null = file did not exist).
  before    String?
  /// Latest content written by the agent (null = deleted).
  after     String?
  /// pending | accepted | reverted
  status    String   @default("pending")
  turn      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PermissionRule {
  id        String   @id @default(cuid())
  /// "global" or an absolute project path.
  scope     String
  tool      String
  /// allow | deny
  decision  String
  createdAt DateTime @default(now())

  @@unique([scope, tool])
}
